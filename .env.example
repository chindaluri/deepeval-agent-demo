# Copy this file to ".env" and fill in your real keys.
# Or just export them in your shell before running.

# Used by the agents, the DeepEval judge, and the guardrails (Gemini)
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
USE_GEMINI_MODEL=true

# Optional. The demo runs on Gemini when GOOGLE_API_KEY is set.
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
